---
import Base from '../layouts/Base.astro';
import { properties } from '../data/properties';
import { site, wa } from '../data/site';

const channels = [
  { l: 'WhatsApp & Phone', v: site.phoneDisplay, href: `tel:+91${site.phone}` },
  { l: 'Email', v: site.email, href: `mailto:${site.email}` },
  { l: 'Instagram', v: '@aadhyafarmstays', href: site.socials.instagram },
  { l: 'Areas we cover', v: site.areas.join(' · ') },
];
---

<Base
  title="Contact Aadhya Farm Stays | Book a Farmhouse near Hyderabad"
  description="Call or WhatsApp +91 98851 02525 to book a private farmhouse near Hyderabad. Send us your dates and group size and we will confirm availability."
>
  <section class="wrap pt-14 pb-16 md:pt-20">
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow">Get in touch</p>
        <h1 class="font-display mt-3 text-4xl leading-tight font-semibold text-ink sm:text-5xl">
          Let us find you the right farmhouse
        </h1>
        <p class="mt-5 text-base leading-relaxed text-muted sm:text-lg">
          The fastest way to book is WhatsApp. Send your dates and group size and we will come
          back with availability and a final price. We answer calls too.
        </p>

        <dl class="mt-10 space-y-6">
          {channels.map((c) => (
            <div class="border-t border-forest-100 pt-5">
              <dt class="text-[0.7rem] font-semibold tracking-[0.16em] text-muted uppercase">{c.l}</dt>
              <dd class="font-display mt-1.5 text-lg font-semibold text-ink">
                {c.href ? (
                  <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="transition-colors hover:text-forest-600">
                    {c.v}
                  </a>
                ) : (
                  c.v
                )}
              </dd>
            </div>
          ))}
        </dl>

        <a
          href={wa('Hi Aadhya Farm Stays!')}
          target="_blank"
          rel="noopener"
          class="mt-10 inline-block rounded-full bg-[#25D366] px-7 py-3.5 text-sm font-semibold text-white transition hover:brightness-95"
        >
          Open WhatsApp chat
        </a>
      </div>

      <div class="rounded-3xl border border-forest-100 bg-white p-7 shadow-sm md:p-9">
        <h2 class="font-display text-2xl font-semibold text-ink">Send an enquiry</h2>
        <p class="mt-2 text-sm text-muted">
          Fill this in and it will open WhatsApp with your message ready to send.
        </p>

        <form id="enquiry" class="mt-7 space-y-4">
          <div>
            <label for="name" class="block text-xs font-semibold tracking-wide text-ink uppercase">Your name</label>
            <input id="name" name="name" type="text" required
              class="mt-1.5 w-full rounded-lg border border-forest-100 bg-cream px-4 py-2.5 text-sm outline-none focus:border-forest-500" />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="dates" class="block text-xs font-semibold tracking-wide text-ink uppercase">Dates</label>
              <input id="dates" name="dates" type="text" placeholder="e.g. 14-15 Nov" required
                class="mt-1.5 w-full rounded-lg border border-forest-100 bg-cream px-4 py-2.5 text-sm outline-none focus:border-forest-500" />
            </div>
            <div>
              <label for="guests" class="block text-xs font-semibold tracking-wide text-ink uppercase">Guests</label>
              <input id="guests" name="guests" type="number" min="1" max="60" placeholder="12" required
                class="mt-1.5 w-full rounded-lg border border-forest-100 bg-cream px-4 py-2.5 text-sm outline-none focus:border-forest-500" />
            </div>
          </div>

          <div>
            <label for="property" class="block text-xs font-semibold tracking-wide text-ink uppercase">Farmhouse</label>
            <select id="property" name="property"
              class="mt-1.5 w-full rounded-lg border border-forest-100 bg-cream px-4 py-2.5 text-sm outline-none focus:border-forest-500">
              <option value="Not sure yet, please suggest">Not sure yet, please suggest</option>
              {properties.map((p) => <option value={p.name}>{p.name}</option>)}
              <option value="An event (party / shoot / corporate)">An event (party / shoot / corporate)</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold tracking-wide text-ink uppercase">Anything else</label>
            <textarea id="message" name="message" rows="3" placeholder="Occasion, cook required, campfire…"
              class="mt-1.5 w-full resize-y rounded-lg border border-forest-100 bg-cream px-4 py-2.5 text-sm outline-none focus:border-forest-500"></textarea>
          </div>

          <button type="submit"
            class="w-full rounded-full bg-forest-500 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-forest-600">
            Send via WhatsApp
          </button>
          <p class="text-center text-xs text-muted">No account needed. It opens your own WhatsApp.</p>
        </form>
      </div>
    </div>
  </section>

  <script define:vars={{ phoneIntl: site.phoneIntl }}>
    const form = document.getElementById('enquiry');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const lines = [
        `Hi Aadhya Farm Stays, I would like to enquire.`,
        ``,
        `Name: ${f.get('name')}`,
        `Dates: ${f.get('dates')}`,
        `Guests: ${f.get('guests')}`,
        `Farmhouse: ${f.get('property')}`,
      ];
      const extra = (f.get('message') || '').toString().trim();
      if (extra) lines.push(`Notes: ${extra}`);
      window.open(`https://wa.me/${phoneIntl}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank');
    });
  </script>
</Base>

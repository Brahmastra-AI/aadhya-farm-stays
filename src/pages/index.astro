---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import PropertyCard from '../components/PropertyCard.astro';
import { properties } from '../data/properties';
import { site, wa } from '../data/site';

const stats = [
  { n: '22', l: 'Guests per farmhouse' },
  { n: '3 BHK', l: 'Private villas' },
  { n: '100%', l: 'Whole property yours' },
  { n: '2PM / 11AM', l: 'Check-in / Check-out' },
];

const occasions = [
  { t: 'Family Reunions', d: 'Room for the whole family: grandparents, cousins and all the kids.', i: 'M12 4.5a3 3 0 1 1 0 6 3 3 0 0 1 0-6ZM4 20a8 8 0 0 1 16 0' },
  { t: 'Birthday Parties', d: 'Lawn space, music, lights and a campfire to finish the night.', i: 'M12 3v2m-7 6h14v9H5v-9Zm2-3a2 2 0 1 1 4 0 2 2 0 0 1-4 0Z' },
  { t: 'Bachelor Parties', d: 'A private property to yourselves. No neighbours, no curfew.', i: 'M7 4h10l-1 7a4 4 0 0 1-8 0L7 4Zm5 11v5m-3 0h6' },
  { t: 'Corporate Offsites', d: 'Get the team out of the office for a day of work and downtime.', i: 'M4 7h16v13H4V7Zm5 0V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2' },
  { t: 'Pre-Wedding Shoots', d: 'Gardens, pools and golden-hour light across the property.', i: 'M4 7h3l2-2h6l2 2h3v12H4V7Zm8 3.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7Z' },
  { t: 'Weekend Getaways', d: 'An hour from the city, and a world away from it.', i: 'M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18' },
];

const amenities = [
  { t: 'Private Swimming Pool', d: 'Every property has its own pool, yours alone for the stay.' },
  { t: 'Campfire Area', d: 'Set up for bonfire evenings under the open sky.' },
  { t: 'Full Kitchen', d: 'Cook for yourselves, or arrange a cook in advance.' },
  { t: 'Outdoor Kitchen', d: 'Covered open-air cooking and dining space.' },
  { t: 'Music & Projector', d: 'Party speaker and projector setup at select properties.' },
  { t: 'Large Lawns', d: 'Open green space for games, events and gatherings.' },
  { t: 'Landscaped Gardens', d: 'Mature planting, lit walkways and quiet corners.' },
  { t: 'Ample Parking', d: 'Space on-site for several cars and a tempo traveller.' },
];

const steps = [
  { n: '01', t: 'Tell us your dates', d: 'Message us on WhatsApp with your dates, group size and which farmhouse caught your eye.' },
  { n: '02', t: 'We confirm availability', d: 'We check the calendar and send you the exact price for your dates, with everything included.' },
  { n: '03', t: 'Block it with an advance', d: 'A part-payment holds the booking. The balance is settled at check-in.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.name,
  description: 'Private farmhouses and resorts for rent around Hyderabad.',
  telephone: `+91${site.phone}`,
  email: site.email,
  url: 'https://www.aadhyafarmstays.com/',
  address: { '@type': 'PostalAddress', addressLocality: 'Hyderabad', addressRegion: 'Telangana', addressCountry: 'IN' },
  areaServed: site.areas.map((a) => ({ '@type': 'Place', name: a })),
  sameAs: Object.values(site.socials),
};
---

<Base
  title="Aadhya Farm Stays | Private Farmhouses for Rent in Hyderabad"
  description="Rent a private 3BHK farmhouse near Hyderabad with a swimming pool, campfire and large lawn. Whole property to yourself, up to 22 guests. From ₹17,000 a night."
  image="/img/sahaja-lake-front-gardens-kothlapur/01-1600.webp"
  schema={schema}
>
  <section class="relative isolate overflow-hidden">
    <Photo
      dir="sahaja-lake-front-gardens-kothlapur"
      base="01"
      alt="Aadhya farmhouse villa with a wide green lawn"
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-forest-900/75 via-forest-900/55 to-forest-900/80"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-forest-900/70 via-forest-900/20 to-transparent"></div>

    <div class="wrap flex min-h-[86svh] flex-col justify-center py-24 text-white">
      <p class="rise mb-5 inline-flex w-fit items-center gap-2 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-xs font-medium backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-leaf-500"></span>
        Moinabad · Chevella · Thangadpally · Shamshabad
      </p>
      <h1 class="rise font-display max-w-3xl text-4xl leading-[1.08] font-semibold tracking-tight sm:text-5xl lg:text-6xl">
        The whole farmhouse.<br />
        <em class="font-normal text-leaf-300">Just for your people.</em>
      </h1>
      <p class="rise mt-6 max-w-xl text-base leading-relaxed text-white/85 sm:text-lg">
        Private 3BHK farmhouses an hour from Hyderabad, with a swimming pool, campfire, open lawns and
        room for twenty-two. No shared spaces, no strangers.
      </p>
      <div class="rise mt-9 flex flex-wrap gap-3">
        <a
          href={wa('Hi Aadhya Farm Stays, I would like to check availability for a farmhouse.')}
          target="_blank"
          rel="noopener"
          class="rounded-full bg-leaf-500 px-7 py-3.5 text-sm font-semibold text-forest-900 shadow-lg shadow-black/20 transition hover:bg-leaf-300"
        >
          Check availability
        </a>
        <a
          href="/farmhouses/"
          class="rounded-full border border-white/35 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/15"
        >
          Browse farmhouses
        </a>
      </div>
    </div>

    <div class="border-t border-white/15 bg-forest-900/55 backdrop-blur-sm">
      <div class="wrap grid grid-cols-2 gap-y-7 py-8 text-white md:grid-cols-4">
        {stats.map((s) => (
          <div class="text-center">
            <p class="font-display text-2xl font-semibold text-leaf-300 md:text-3xl">{s.n}</p>
            <p class="mt-1 text-[0.7rem] tracking-wide text-white/70 uppercase md:text-xs">{s.l}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="about" class="wrap py-20 md:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow">About Aadhya</p>
        <h2 class="font-display mt-3 text-3xl leading-tight font-semibold text-ink sm:text-4xl">
          Farmhouses we actually look after
        </h2>
        <div class="mt-6 space-y-4 text-base leading-relaxed text-muted">
          <p>
            Aadhya Farm Stays rents out private farmhouses in the green belt around Hyderabad:
            Moinabad, Chevella, Thangadpally and Shamshabad. When you book one, you get the entire
            property: the house, the pool, the lawn and the gardens.
          </p>
          <p>
            Each place is visited, photographed and priced by us. What you see on the page is what
            you arrive to. Bookings are confirmed directly over WhatsApp or a phone call, so you
            always speak to a person who knows the property.
          </p>
        </div>
        <a
          href="/farmhouses/"
          class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-forest-600 transition hover:gap-3 hover:text-forest-700"
        >
          See all farmhouses <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <Photo
          dir="pine-creek-thangadpally"
          base="10"
          alt="Landscaped garden at Pine Creek Farm Stay"
          sizes="(min-width: 1024px) 25vw, 45vw"
          class="aspect-[3/4] w-full rounded-2xl object-cover shadow-lg shadow-forest-900/10"
        />
        <Photo
          dir="pine-creek-thangadpally"
          base="02"
          alt="Swimming pool lit at night"
          sizes="(min-width: 1024px) 25vw, 45vw"
          class="mt-8 aspect-[3/4] w-full rounded-2xl object-cover shadow-lg shadow-forest-900/10"
        />
      </div>
    </div>
  </section>

  <section id="farmhouses" class="bg-white py-20 md:py-28">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Our Properties</p>
          <h2 class="font-display mt-3 text-3xl leading-tight font-semibold text-ink sm:text-4xl">
            Pick your farmhouse
          </h2>
        </div>
        <a href="/farmhouses/" class="text-sm font-semibold text-forest-600 hover:text-forest-700">View all →</a>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {properties.map((p, i) => <PropertyCard property={p} eager={i === 0} />)}

        <article class="flex flex-col items-start justify-center rounded-2xl border border-dashed border-forest-300 bg-forest-50 p-8">
          <p class="eyebrow">More coming</p>
          <h3 class="font-display mt-2 text-xl font-semibold text-ink">Looking for something else?</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            We have more farmhouses across Moinabad, Chevella and Shamshabad, from 2BHK cottages to
            larger resorts for events. Tell us your dates and group size.
          </p>
          <a
            href={wa('Hi, I am looking for a farmhouse. Here are my dates and group size:')}
            target="_blank"
            rel="noopener"
            class="mt-5 rounded-full bg-forest-500 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-forest-600"
          >
            Ask us on WhatsApp
          </a>
        </article>
      </div>
    </div>
  </section>

  <section id="occasions" class="wrap py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow">What people book us for</p>
      <h2 class="font-display mt-3 text-3xl leading-tight font-semibold text-ink sm:text-4xl">
        Built for the occasions that need space
      </h2>
    </div>

    <div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-forest-100 bg-forest-100 sm:grid-cols-2 lg:grid-cols-3">
      {occasions.map((o) => (
        <div class="group bg-cream p-7 transition-colors hover:bg-white">
          <svg
            class="h-7 w-7 text-forest-500 transition-colors group-hover:text-leaf-500"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d={o.i} />
          </svg>
          <h3 class="font-display mt-4 text-lg font-semibold text-ink">{o.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{o.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="amenities" class="bg-forest-900 py-20 text-white md:py-28">
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="text-[0.72rem] font-semibold tracking-[0.18em] text-leaf-300 uppercase">
          What is included
        </p>
        <h2 class="font-display mt-3 text-3xl leading-tight font-semibold sm:text-4xl">
          The things that make a weekend work
        </h2>
      </div>

      <div class="mt-12 grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:grid-cols-4">
        {amenities.map((a) => (
          <div class="border-t border-white/15 pt-5">
            <h3 class="text-sm font-semibold text-leaf-300">{a.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/70">{a.d}</p>
          </div>
        ))}
      </div>

      <p class="mt-12 text-sm text-white/55">
        Amenities vary slightly by property. Each farmhouse page lists exactly what that place has.
      </p>
    </div>
  </section>

  <section class="wrap py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow">Booking</p>
      <h2 class="font-display mt-3 text-3xl leading-tight font-semibold text-ink sm:text-4xl">
        Three steps, one phone call
      </h2>
    </div>
    <ol class="mt-12 grid gap-8 md:grid-cols-3">
      {steps.map((s) => (
        <li class="relative rounded-2xl border border-forest-100 bg-white p-7">
          <span class="font-display text-4xl font-semibold text-leaf-300">{s.n}</span>
          <h3 class="font-display mt-3 text-lg font-semibold text-ink">{s.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap pb-4">
    <div class="relative isolate overflow-hidden rounded-3xl px-6 py-16 text-center md:px-16 md:py-20">
      <Photo dir="pine-creek-thangadpally" base="01" alt="" sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-forest-900/75"></div>
      <h2 class="font-display mx-auto max-w-2xl text-3xl leading-tight font-semibold text-white sm:text-4xl">
        Free this weekend?
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-base text-white/80">
        Tell us when you want to come and how many of you there are. We will do the rest.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a
          href={wa('Hi Aadhya Farm Stays, I would like to book a farmhouse. My dates are:')}
          target="_blank"
          rel="noopener"
          class="rounded-full bg-leaf-500 px-7 py-3.5 text-sm font-semibold text-forest-900 transition hover:bg-leaf-300"
        >
          Book on WhatsApp
        </a>
        <a
          href={`tel:+91${site.phone}`}
          class="rounded-full border border-white/35 px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10"
        >
          Call {site.phoneDisplay}
        </a>
      </div>
    </div>
  </section>
</Base>

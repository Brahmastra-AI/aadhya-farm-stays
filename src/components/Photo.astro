---
interface Props {
  /** e.g. "pine-creek" */
  dir: string;
  /** e.g. "01" */
  base: string;
  alt: string;
  class?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto';
}
const {
  dir,
  base,
  alt,
  class: className = '',
  sizes = '(min-width: 1024px) 50vw, 100vw',
  loading = 'lazy',
  fetchpriority = 'auto',
} = Astro.props;
const src = `/img/${dir}/${base}-1600.webp`;
---
<img
  src={src}
  srcset={`/img/${dir}/${base}-800.webp 800w, ${src} 1600w`}
  sizes={sizes}
  alt={alt}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  class={className}
/>

---
import { site, wa } from '../data/site';

const links = [
  { href: '/farmhouses/', label: 'Farmhouses' },
  { href: '/#occasions', label: 'Occasions' },
  { href: '/#amenities', label: 'Amenities' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 border-b border-forest-100 bg-cream/85 backdrop-blur-md">
  <div class="wrap flex h-16 items-center justify-between gap-4 md:h-20">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${site.name} home`}>
      <img src="/img/brand/logo.webp" alt="" width="40" height="40"
           class="h-9 w-auto object-contain md:h-11" />
      <span class="font-display text-lg leading-none font-semibold tracking-tight text-forest-700 md:text-xl">
        Aadhya <span class="block text-[0.6rem] tracking-[0.22em] text-leaf-600 uppercase">Farm Stays</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class="text-sm font-medium text-muted transition-colors hover:text-forest-600">{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={`tel:+91${site.phone}`}
         class="hidden items-center gap-1.5 text-sm font-semibold text-forest-700 sm:flex">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293a.75.75 0 0 1-.92.265 12.035 12.035 0 0 1-5.58-5.58.75.75 0 0 1 .265-.92l1.293-.97c.362-.271.527-.734.417-1.173L8.704 3.852A1.125 1.125 0 0 0 7.613 3H6.25A2.25 2.25 0 0 0 4 5.25v1.5Z" />
        </svg>
        Call
      </a>
      <a href={wa('Hi Aadhya Farm Stays, I would like to know more about your farmhouses.')}
         target="_blank" rel="noopener"
         class="rounded-full bg-forest-500 px-3.5 py-2 text-[0.8rem] font-semibold whitespace-nowrap text-white shadow-sm transition hover:bg-forest-600 sm:text-sm md:px-5">
        Book Now
      </a>

      <details class="relative lg:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-forest-100 text-forest-700 [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 z-50 mt-3 w-56 overflow-hidden rounded-xl border border-forest-100 bg-white py-2 shadow-xl"
          aria-label="Mobile"
        >
          {links.map((l) => (
            <a href={l.href} class="block px-5 py-2.5 text-sm font-medium text-muted hover:bg-forest-50 hover:text-forest-700">
              {l.label}
            </a>
          ))}
          <a href={`tel:+91${site.phone}`} class="block border-t border-forest-50 px-5 py-2.5 text-sm font-semibold text-forest-700 hover:bg-forest-50">
            Call {site.phoneDisplay}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

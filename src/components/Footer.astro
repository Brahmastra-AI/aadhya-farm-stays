---
import { site, wa } from '../data/site';
import { properties } from '../data/properties';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-ocean-100 bg-white">
  <div class="wrap grid gap-10 py-14 md:grid-cols-4 md:py-16">
    <div class="md:col-span-2">
      <img src="/img/brand/logo.webp" alt={site.name} width="150" height="88" class="h-14 w-auto object-contain" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">
        Private farmhouses and resorts for rent around Hyderabad, for family weekends,
        birthdays, reunions, corporate offsites and shoots.
      </p>
      <div class="mt-5 flex gap-3">
        {Object.entries(site.socials).map(([k, href]) => (
          <a href={href} target="_blank" rel="noopener"
             class="rounded-full border border-ocean-100 px-3 py-1.5 text-xs font-medium text-ocean-700 capitalize transition hover:border-ocean-500 hover:text-ocean-600">
            {k}
          </a>
        ))}
      </div>
    </div>

    <div>
      <h3 class="text-xs font-semibold tracking-[0.18em] text-ink uppercase">Our Farmhouses</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-muted">
        {properties.map((p) => (
          <li><a href={`/farmhouses/${p.slug}/`} class="transition-colors hover:text-ocean-600">{p.shortName}</a></li>
        ))}
        <li><a href="/farmhouses/" class="transition-colors hover:text-ocean-600">View all</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-semibold tracking-[0.18em] text-ink uppercase">Get in Touch</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-muted">
        <li><a href={`tel:+91${site.phone}`} class="transition-colors hover:text-ocean-600">{site.phoneDisplay}</a></li>
        <li><a href={`mailto:${site.email}`} class="break-all transition-colors hover:text-ocean-600">{site.email}</a></li>
        <li><a href={wa('Hi Aadhya Farm Stays!')} target="_blank" rel="noopener" class="transition-colors hover:text-ocean-600">WhatsApp us</a></li>
        <li><a href="/contact/" class="transition-colors hover:text-ocean-600">Contact & enquiry</a></li>
        <li><a href="/terms/" class="transition-colors hover:text-ocean-600">Terms & conditions</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ocean-100">
    <div class="wrap flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>{site.areas.join(' · ')}</p>
    </div>
  </div>
</footer>
